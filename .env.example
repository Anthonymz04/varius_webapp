# Never commit .env.local. Obtain this value from the OpenAI dashboard.
OPENAI_API_KEY= api_open_ai
# Use a small, capable model for legal-orientation conversations.
OPENAI_MODEL=gpt-4.1-mini

# Firebase web configuration (public identifiers; do not place service-account keys here)
NEXT_PUBLIC_FIREBASE_API_KEY= 
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= 
NEXT_PUBLIC_FIREBASE_PROJECT_ID= 
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET= 
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= 
NEXT_PUBLIC_FIREBASE_APP_ID= 
