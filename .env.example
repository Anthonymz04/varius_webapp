# Never commit .env.local. Obtain this value from the OpenAI dashboard.

# ---- Proveedor IA (OpenAI-compatible: b.ai, OpenRouter, NVIDIA NIM, Kilo, OmniRoute...) ----
# Proveedor principal (o único). Con solo rellenar estas 3 el asistente funciona:
OPENAI_API_KEY= sk secret        # key del proveedor elegido
OPENAI_MODEL=deepseek-v4-flash   # id del modelo en ese proveedor
OPENAI_BASE_URL=https://api.b.ai/v1   # o https://openrouter.ai/api/v1, etc.

# Fallbacks opcionales (si la key principal se cae o agota cuota, la ruta los
# prueba en orden AI_PROVIDER_ORDER). Rellena solo los que uses:
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_PROVIDER_ORDER=custom,nvidia-nim,openrouter
# AI_TIMEOUT_MS=25000   # timeout por proveedor
# AI_MAX_TOKENS=2000

# Firebase web configuration (public identifiers; do not place service-account keys here)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
