# Never commit .env.local. Obtain this value from the OpenAI dashboard.
OPENAI_API_KEY= sk secret

# Use a small, capable model for legal-orientation conversations.
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=https://api.b.ai/v1

# Firebase web configuration (public identifiers; do not place service-account keys here)
NEXT_PUBLIC_FIREBASE_API_KEY= 
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN= 
NEXT_PUBLIC_FIREBASE_PROJECT_ID= 
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET= 
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID= 
NEXT_PUBLIC_FIREBASE_APP_ID= 
