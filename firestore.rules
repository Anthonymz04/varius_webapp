rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(userId) { return signedIn() && request.auth.uid == userId; }
    function validRole() { return request.resource.data.role in ['citizen', 'student', 'lawyer']; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owns(userId) && validRole();
      allow update: if owns(userId) && (request.resource.data.role == resource.data.role ||
        (request.resource.data.role == 'lawyer' && request.resource.data.nationalId is string && request.resource.data.certificateURL is string));
      allow delete: if false;
    }

    match /lawyers/{lawyerId} { allow read: if signedIn(); allow write: if owns(lawyerId); }
    match /posts/{postId} { allow read: if true; allow create: if signedIn(); allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid; }

    match /conversations/{conversationId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow read, update: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /consultationRequests/{requestId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.clientId;
      allow read: if signedIn() && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.lawyerId);
      allow update: if signedIn() && request.auth.uid == resource.data.lawyerId;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.actorId;
      allow read, update: if signedIn() && request.auth.uid == resource.data.userId;
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    match /actionHistory/{entryId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow update, delete: if false;
    }

    match /mail/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.actorId;
      allow read, update, delete: if false;
    }

    match /bookings/{bookingId} { allow read, create: if signedIn(); allow update: if signedIn(); allow delete: if false; }
    match /tutoria_reservas/{doc} { allow read, create: if signedIn(); allow update: if signedIn(); allow delete: if false; }

    match /lawyer_verifications/{uid} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /consultations/{doc} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /community_posts/{doc} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    match /community_comments/{doc} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}