<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFBF9"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/offlineLogo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Sin conexión"
        android:textColor="#2D1B12"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="Parece que no estás conectado o existen problemas en la red.\nPor favor, verifica tu conexión a internet."
        android:textColor="#6B573F"
        android:textSize="15sp" />

    <Button
        android:id="@+id/offlineRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="#b45935"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Reintentar"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
